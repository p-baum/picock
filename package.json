{
  "name": "mattpocock-skills",
  "version": "1.2.2",
  "private": true,
  "description": "Matt Pocock's agent skills for real engineering",
  "keywords": [
    "pi-package"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mattpocock/skills"
  },
  "license": "MIT",
  "pi": {
    "extensions": [
      "./extensions",
      "./node_modules/@tintinweb/pi-subagents/src/index.ts"
    ],
    "skills": [
      "./skills",
      "!skills/deprecated/**",
      "!skills/in-progress/**",
      "!skills/misc/**",
      "!skills/personal/**"
    ]
  },
  "dependencies": {
    "@tintinweb/pi-subagents": "^0.14.3"
  },
  "bundledDependencies": [
    "@tintinweb/pi-subagents"
  ],
  "scripts": {
    "changeset": "changeset",
    "validate:skills": "node scripts/validate-skill-distribution.mjs",
    "version": "changeset version && node scripts/sync-plugin-version.mjs",
    "check-plugin-version": "node scripts/sync-plugin-version.mjs --check"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.30.0"
  },
  "packageManager": "npm@10.9.4"
}
